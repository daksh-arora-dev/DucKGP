# Groq LLM
llm_api_key=make account in groqcloud and get the api key
LLM_MODEL=openai/gpt-oss-120b

# MCP Server
MCP_URL=http://127.0.0.1:8001/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8001

# IQPS
iqps_base_url=https://iqps-server.metakgp.org

#SUPABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=your_supabase_secret_key

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_FRONTEND_URL=http://localhost:5173
GMAIL_ENCRYPTION_KEY=your_generated_encryption_key